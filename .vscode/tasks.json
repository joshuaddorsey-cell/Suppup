{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Suppup: Analyze",
      "type": "shell",
      "command": "flutter",
      "args": ["analyze", "--no-pub"],
      "group": "test",
      "problemMatcher": "$dart-analyze"
    },
    {
      "label": "Suppup: Test",
      "type": "shell",
      "command": "flutter",
      "args": ["test", "--no-pub"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Suppup: Build Android APK",
      "type": "shell",
      "command": "flutter",
      "args": ["build", "apk", "--debug", "--no-pub"],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
